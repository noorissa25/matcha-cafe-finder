# Local dev with no Postgres server: SQLite file (path is relative to the schema file)
DATABASE_URL="file:../dev.db"

# Or PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/matcha_cafe_finder"

# Optional: adds a short AI-written note on the recommendations page.
# Leave unset and the app uses only the built-in scoring.
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-opus-5-5"
